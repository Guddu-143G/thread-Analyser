# Copy this file to .env before running docker-compose up.
# These are read by the backend, worker, and beat services.

APP_NAME=Threat Analyser
ENV=production

# IMPORTANT: generate a strong random value for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=720

# These match the db/redis service names in docker-compose.yml — leave as-is
# for the bundled Compose stack. Override only for external managed
# Postgres/Redis (cloud deployment).
DATABASE_URL=postgresql+psycopg2://threat:threat@db:5432/threat_analyser
REDIS_URL=redis://redis:6379/0

# Comma-separated list of allowed origins for the frontend, or "*" for any
# (fine for local/self-host; restrict this in a real production deployment).
CORS_ORIGINS=*
